{
  "name": "zappd",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm install && npx expo install --fix",
  "postAttachCommand": "echo '\\n  zappd is ready. Type:  npm run phone\\n'",
  "forwardPorts": [8081],
  "customizations": { "codespaces": { "openFiles": ["PHONE.md"] } }
}
