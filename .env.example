# Copy this file to .env and fill in the values (see README, steps 2–4).

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Open Charge Map → My Profile → My Apps (free). Gives chargers across India.
EXPO_PUBLIC_OCM_KEY=

# Google Cloud → Maps SDK for Android key (free for mobile map display). Android only.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Google sign-in (free): Google Cloud → APIs & Services → Credentials → OAuth client IDs.
# Web client ID (also pasted into Supabase → Auth → Providers → Google):
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID, and its reversed form for the URL scheme:
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
